# NebulaProxy — Flaregun rotating proxy env (copy to .dev.vars for local dev;
# .dev.vars is git-ignored — never commit real secrets).

# Cloudflare credentials used by the Flaregun CLI (`flaregun init` / `flaregun up`).
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Fleet size + rotation strategy (also set in wrangler.toml [vars] for deploy).
WORKER_COUNT=20
FLAREGUN_STRATEGY=adaptive   # adaptive | round-robin | random

# Per-IP cooldown (seconds) — how long a sibling worker/IP stays cooling down
# after a rate limit is detected before it is used again.
IP_COOLDOWN_SECONDS=300

# Comma-separated sibling worker /api/proxy URLs (each a different Cloudflare
# egress IP). Populate after `flaregun up 20` (from `flaregun ls` output).
FLEET_URLS=

# Optional self-label for a single fleet node (used in /api/proxy mode=json output).
WORKER_ID=
