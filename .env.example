# ===== Rotating Proxy Portal - Environment Config (EXAMPLE) =====
# Copy to .env and fill in real values. .env is gitignored.
PORT=3000
GATEWAY_PORT=8000
NODE_ENV=production

# Public host/IP shown to clients in the admin panel & credentials (set to your server IP/domain)
PUBLIC_HOST=YOUR_SERVER_IP

# Admin auth — generate a bcrypt hash for ADMIN_PASSWORD_HASH (e.g. `node -e "console.log(require('bcryptjs').hashSync('yourpass',10))"`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX
JWT_EXPIRES_IN=12h

# REST API key (for programmatic access to /api/* stats endpoints)
API_KEY=CHANGE_ME

# Rotating proxy gateway credentials (clients must supply these to use the gateway)
GATEWAY_USER=CHANGE_ME
GATEWAY_PASS=CHANGE_ME

# Health check
HEALTH_CHECK_INTERVAL_SEC=120
